{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "maxNodeModuleJsDepth": 0,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["lib/**/*.js", "utils/**/*.js", "bin/**/*.js", "prompt/**/*.js"]
}
